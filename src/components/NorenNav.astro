---
import type { NavItem } from '../lib/nav.ts';
import "../styles/noren-component.css"

type Props = {
    items: NavItem[];
    currentPath?: string;
	retro?: boolean;
}

const { items, currentPath = Astro.url.pathname, retro = false } = Astro.props;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalizePath(currentPath);
---

<div class:list={["noren", retro && "is-retro"]}>
	<div class="noren-illustration" aria-hidden="true"></div>
    <nav class="noren-selections" aria-label="Sections">
    {
        items.map((item) => {
            const target = normalizePath(item.href);
            const isHome = target === normalizePath(import.meta.env.BASE_URL);
            const active = isHome ? current === target : current === target || current.startsWith(`${target}/`);
            return (
                <a
                    class:list={["noren__strip", active && "is-active"]}
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                >
                    {item.label}
                </a>
            );
        })
    }
    </nav>
	{retro && <p class="noren-file-note" aria-hidden="true">NOREN_NAV.GIF // 61 KB // 32 COLORS</p>}
</div>
