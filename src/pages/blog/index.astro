---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import chroniclerPortrait from '../../assets/chronicler/chronicler-neutral.png';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { withBase } from '../../lib/nav';
import WorldLayout from '../../layouts/WorldLayout.astro';
import '../../styles/chronicler.css';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<WorldLayout
	title={`The Chronicler — ${SITE_TITLE}`}
	description="The Chronicler's field notes: devlogs, unfinished experiments, and lessons rescued beyond the map."
	image={chroniclerPortrait}
	bodyClass="chronicler-world"
>
	<div class="chronicler-shell">
		<nav class="chronicle-nav" aria-label="Chronicler navigation">
			<a href={withBase()}>← return to the front page</a>
			<p><span>FIELD LOG</span> / VOL. 01 / ALWAYS IN PROGRESS</p>
		</nav>

		<section class="chronicle-cover" aria-labelledby="chronicle-title">
			<div class="chronicle-copy">
				<p class="chronicle-kicker">ROUGH COUNTRY // FIELD RECORDER</p>
				<h1 id="chronicle-title"><span>The</span> Chronicler</h1>
				<p class="chronicle-deck">
					He crosses unfinished places and records strange trails, failed builds, and useful
					mistakes before the weather takes them.
				</p>
				<blockquote>“If it broke once, write down why.”</blockquote>
				<dl class="chronicle-facts">
					<div><dt>Known as</dt><dd>The Chronicler</dd></div>
					<div><dt>Habitat</dt><dd>Where the map stops being useful</dd></div>
					<div><dt>Disposition</dt><dd>Weathered. Stubborn. Still taking notes.</dd></div>
				</dl>
			</div>

			<figure class="chronicler-portrait">
				<div class="portrait-crop">
					<Image
						src={chroniclerPortrait}
						alt="The Chronicler, a manga-style character with enormous messy curls and a full beard, looking left in profile."
						loading="eager"
					/>
				</div>
				<figcaption>
					<b>DAN // THE CHRONICLER</b>
					<span>Explorer of unfinished places. Collector of useful mistakes.</span>
				</figcaption>
			</figure>

			<p class="ink-stamp" aria-hidden="true">RECORDED<br />BY HAND</p>
		</section>

		<section class="chronicle-entries" aria-labelledby="entries-title">
			<header>
				<div>
					<p>THE WORKBENCH INDEX</p>
					<h2 id="entries-title">Recovered notes</h2>
				</div>
				<span>{String(posts.length).padStart(2, '0')} PUBLIC ENTRIES</span>
			</header>

			{
				posts.length > 0 ? (
					<ol class="chronicle-list">
						{posts.map((post, index) => (
							<li>
								<a href={withBase(`blog/${post.id}/`)}>
									<span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
									<div>
										<p><FormattedDate date={post.data.pubDate} /></p>
										<h3>{post.data.title}</h3>
										<span>{post.data.description}</span>
									</div>
									<b>OPEN FILE →</b>
								</a>
							</li>
						))}
					</ol>
				) : (
					<div class="empty-log">
						<p class="empty-number">000</p>
						<div>
							<p class="margin-note">THE INK IS STILL WET</p>
							<h3>No public entries—yet.</h3>
							<p>
								The starter articles remain safely marked as drafts. The first real field note will
								appear here and in the RSS feed when The Chronicler decides it survived the workshop.
							</p>
							<a href={withBase('rss.xml')}>watch the RSS wire →</a>
						</div>
					</div>
				)
			}
		</section>

		<footer class="chronicle-footer">
			<p>END OF CURRENT RECORD // MORE MARGINS WILL BE ADDED</p>
			<a href={withBase()}>back to dancold.cafe</a>
		</footer>
	</div>
</WorldLayout>
