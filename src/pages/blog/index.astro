---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import chroniclerPortrait from '../../assets/chronicler/chronicler-neutral.png';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { withBase } from '../../lib/nav';
import WorldLayout from '../../layouts/WorldLayout.astro';
import '../../styles/chronicler.css';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<WorldLayout
	title={`The Chronicler — ${SITE_TITLE}`}
	description="The Chronicler's travel diary: field reports, unfinished expeditions, and lessons carried home."
	image={chroniclerPortrait}
	bodyClass="chronicler-world"
>
	<div class="chronicler-shell">
		<nav class="chronicle-nav" aria-label="Chronicler navigation">
			<a href={withBase()}>← return to the front page</a>
			<p><span>TRAVEL DIARY</span> / JOURNAL I / ROAD STILL OPEN</p>
		</nav>

		<section class="travel-diary" aria-labelledby="chronicle-title">
			<div class="diary-spine" aria-hidden="true"></div>

			<article class="diary-page field-page">
				<header class="diary-dateline">
					<span>FIELD ENTRY 000</span>
					<span>DATE: UNRECORDED</span>
				</header>

				<p class="chronicle-kicker">BEYOND THE LAST MARKER</p>
				<h1 id="chronicle-title"><span>The Chronicler's</span> Travel Diary</h1>
				<p class="chronicle-deck">
					A record of roads beyond the last useful map: strange places, broken tools,
					unexpected shelters, and lessons carried home.
				</p>

				<blockquote>“If the road changes you, mark the page.”</blockquote>

				<dl class="journey-facts">
					<div><dt>Current route</dt><dd>Past the final printed border</dd></div>
					<div><dt>Weather</dt><dd>Ink-dry. Wind rising.</dd></div>
					<div><dt>Supplies</dt><dd>One notebook. No clean plans.</dd></div>
				</dl>

				<div class="route-sketch" aria-label="A rough hand-drawn route from camp to an unknown landmark">
					<span class="route-point camp">camp</span>
					<span class="route-path path-one" aria-hidden="true"></span>
					<span class="route-point ford">old ford</span>
					<span class="route-path path-two" aria-hidden="true"></span>
					<span class="route-point unknown">?</span>
				</div>
				<p class="pencil-note">take the ridge if the bridge is gone again</p>
				<span class="page-number">— 01 —</span>
			</article>

			<article class="diary-page clipping-page">
				<span class="paperclip" aria-hidden="true"></span>
				<section class="newspaper-clipping" aria-label="A newspaper clipping about The Chronicler">
					<header class="newspaper-masthead">
						<p>The Wayfarer's Gazette</p>
						<div><span>Special field edition</span><span>Price: one good story</span></div>
					</header>
					<p class="newspaper-rubric">NEWS FROM BEYOND THE LAST MARKER</p>
					<h2>Local Chronicler vanishes beyond the last useful map</h2>
					<p class="newspaper-deck">Explorer leaves the obvious road carrying a weathered journal and very few sensible supplies.</p>

					<figure class="newspaper-photo">
						<div class="newspaper-photo__frame">
							<Image
								src={chroniclerPortrait}
								alt="The Chronicler, a manga-style adventurer with enormous messy curls, a beard, and a weathered cape."
								loading="eager"
							/>
						</div>
						<figcaption>Last known portrait, recovered from a rain-damaged field dispatch.</figcaption>
					</figure>

					<div class="newspaper-columns">
						<p><b>OUTER ROAD —</b> Witnesses say the traveler ignored the marked trail just after sunrise, pausing only to sketch the broken signpost.</p>
						<p>The expedition continues somewhere outside the neat edge of the page. Any useful mistakes will be reported upon his return.</p>
					</div>
					<p class="clipping-mark">CLIPPING 07</p>
				</section>
				<p class="marginalia">Found folded inside the back cover. Keep dry.</p>
				<span class="page-number">— 02 —</span>
			</article>
		</section>

		<section class="chronicle-entries" aria-labelledby="entries-title">
			<header>
				<div>
					<p>FIELD ENTRY INDEX</p>
					<h2 id="entries-title">Pages from the road</h2>
				</div>
				<span>{String(posts.length).padStart(2, '0')} LOGGED ENTRIES</span>
			</header>

			{
				posts.length > 0 ? (
					<ol class="chronicle-list">
						{posts.map((post, index) => (
							<li>
								<a href={withBase(`blog/${post.id}/`)}>
									<span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
									<div>
										<p><FormattedDate date={post.data.pubDate} /></p>
										<h3>{post.data.title}</h3>
										<span>{post.data.description}</span>
									</div>
									<b>READ ENTRY →</b>
								</a>
							</li>
						))}
					</ol>
				) : (
					<div class="empty-log">
						<p class="empty-number">000</p>
						<div>
							<p class="margin-note">THE FIRST PAGE IS STILL BEING WRITTEN</p>
							<h3>No dispatches from the road—yet.</h3>
							<p>
								The starter notes remain closed as drafts. The first field dispatch will surface
								here—and on the RSS trail—when it has survived the weather.
							</p>
							<a href={withBase('rss.xml')}>follow the RSS trail →</a>
						</div>
					</div>
				)
			}
		</section>

		<footer class="chronicle-footer">
			<p>END OF CURRENT JOURNAL // NEXT WAYPOINT UNKNOWN</p>
			<a href={withBase()}>back to dancold.quest</a>
		</footer>
	</div>
</WorldLayout>
