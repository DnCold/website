---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	const library = await getCollection('library');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			libraryEntries: library.filter((entry) => post.data.library.includes(entry.id)),
		},
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	libraryEntries: CollectionEntry<'library'>[];
};

const { post, libraryEntries } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} libraryEntries={libraryEntries}>
	<Content />
</BlogPost>
