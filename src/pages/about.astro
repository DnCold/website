---
import { SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title={`About — ${SITE_TITLE}`}
	description="About DanCold and the ideas behind this personal archive."
>
	<header class="page-heading">
		<div>
			<p class="eyebrow">About this place</p>
			<h1>A digital home, not a business card.</h1>
		</div>
		<p>
			I am DanCold. I use this site to collect visual work, process notes, and projects that do
			not fit neatly inside a social feed.
		</p>
	</header>

	<div class="about-grid">
		<article class="about-copy panel prose">
			<h2>The idea</h2>
			<p>
				I want this website to feel like entering a room full of folders, tests, references, and
				found objects. It does not need to be finished to be alive; it can change whenever the
				work changes.
			</p>
			<p>
				Drawings, animation, 3D, technical notes, and small experiments can all live here. Empty
				sections are part of the record too.
			</p>
			<h2>How it is made</h2>
			<p>
				The direction, taste, and final decisions are personal. The site combines Astro code,
				hands-on editing, and AI-assisted tools for iteration and selected visuals. The point is
				not to pretend the tools are invisible; it is to shape the result into something that feels
				like mine.
			</p>
			<h2>Principles</h2>
			<ul>
				<li>Specific choices before anonymous templates.</li>
				<li>An owned archive before a borrowed feed.</li>
				<li>Honest process before invented purity.</li>
			</ul>
		</article>

		<aside class="cabinet" aria-label="Website record">
			<div class="cabinet-label">
				<span>ARCHIVE</span>
				<strong>DANCOLD / WEB</strong>
			</div>
			<dl>
				<div><dt>Type</dt><dd>Personal web</dd></div>
				<div><dt>Status</dt><dd>In progress</dd></div>
				<div><dt>Contents</dt><dd>Art + notes</dd></div>
				<div><dt>Engine</dt><dd>Astro</dd></div>
			</dl>
			<p class="stamp">AI-ASSISTED<br />PERSONALLY DIRECTED</p>
		</aside>
	</div>
</PageLayout>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.65fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
	}

	.about-copy {
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.about-copy > * {
		margin-right: 0;
		margin-left: 0;
	}

	.cabinet {
		padding: 1.25rem;
		border: 3px double var(--paper);
		background: var(--plum);
		color: var(--paper);
		box-shadow: 7px 7px 0 var(--ink);
		transform: rotate(1deg);
	}

	.cabinet-label {
		padding-bottom: 1rem;
		border-bottom: 1px dashed rgba(246, 234, 212, 0.5);
	}

	.cabinet-label span,
	.cabinet-label strong {
		display: block;
	}

	.cabinet-label span,
	dt {
		font-family: ui-monospace, 'Cascadia Code', monospace;
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.cabinet dl {
		margin: 1.5rem 0;
	}

	.cabinet dl div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.55rem 0;
		border-bottom: 1px dotted rgba(246, 234, 212, 0.35);
	}

	.cabinet dd {
		margin: 0;
		text-align: right;
	}

	.stamp {
		width: max-content;
		max-width: 100%;
		margin: 2rem auto 0.5rem;
		padding: 0.65rem;
		border: 3px solid var(--ice);
		color: var(--ice);
		font-family: ui-monospace, 'Cascadia Code', monospace;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		transform: rotate(-5deg);
	}

	@media (max-width: 780px) {
		.about-grid {
			grid-template-columns: 1fr;
		}

		.cabinet {
			transform: none;
		}
	}
</style>
