---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../lib/nav';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<section class="intro panel">
		<div class="intro-copy">
			<p class="eyebrow">Signal acquired</p>
			<h1>A personal corner in a web that keeps looking the same.</h1>
			<p class="lede">
				This is my archive for notes, drawings, animation, 3D experiments, and small projects
				that deserve a place beyond the feed.
			</p>
			<ul class="tag-list" aria-label="Site topics">
				<li>art</li>
				<li>animation</li>
				<li>3D</li>
				<li>devlog</li>
			</ul>
		</div>

		<aside class="status-card" aria-label="Site status">
			<p class="status-label">STATUS.TXT</p>
			<strong>In progress</strong>
			<p>I am arranging this little space. A few doors still lead to empty shelves.</p>
			<span>latest signal: 2026</span>
		</aside>
	</section>

	<section class="shelves" aria-labelledby="explore">
		<div class="section-title">
			<p class="eyebrow">Site map</p>
			<h2 id="explore">Choose a door</h2>
		</div>

		<div class="shelf-grid">
			<a class="shelf-card notes" href={withBase('blog/')}>
				<span class="card-number">01</span>
				<h3>Notes</h3>
				<p>Ideas, build logs, and things learned while making.</p>
				<b>open notebook →</b>
			</a>
			<a class="shelf-card archivist" href={withBase('archivist/')}>
				<span class="card-number">02</span>
				<h3>The Archivist</h3>
				<p>A cozy, lamplit room for drawings, motion, 3D work, and unfinished things.</p>
				<b>enter the archive →</b>
			</a>
			<a class="shelf-card coldem" href={withBase('coldem/')}>
				<span class="card-number">03</span>
				<h3>Coldem</h3>
				<p>Download the Windows launcher and keep every DanCold game in one cold system.</p>
				<b>get the launcher →</b>
			</a>
			<a class="shelf-card links" href={withBase('links/')}>
				<span class="card-number">04</span>
				<h3>Links</h3>
				<p>Profiles, the RSS feed, and paths toward other corners.</p>
				<b>follow signals →</b>
			</a>
		</div>
	</section>

	<section class="tiny-manifesto panel">
		<p class="eyebrow">Why a personal website</p>
		<blockquote>
			“A page can feel like a room: imperfect, specific, and unmistakably yours.”
		</blockquote>
		<a href={withBase('about/')}>Read about this place →</a>
	</section>
</PageLayout>

<style>
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(15rem, 0.7fr);
		gap: clamp(2rem, 6vw, 5rem);
		padding: clamp(1.5rem, 5vw, 4.5rem);
		background:
			linear-gradient(120deg, rgba(255, 248, 233, 0.96), rgba(246, 234, 212, 0.9)),
			repeating-linear-gradient(90deg, transparent 0 28px, rgba(32, 37, 59, 0.05) 28px 29px);
	}

	.intro::after {
		position: absolute;
		top: -0.85rem;
		right: 8%;
		width: 6rem;
		height: 1.8rem;
		background: rgba(139, 201, 211, 0.62);
		content: '';
		transform: rotate(2deg);
	}

	.lede {
		max-width: 42rem;
		margin-top: 1.5rem;
		font-size: clamp(1.08rem, 2vw, 1.28rem);
	}

	.status-card {
		align-self: end;
		padding: 1.15rem;
		border: 1px dashed var(--paper);
		background: var(--night);
		color: var(--paper);
		box-shadow: 6px 6px 0 var(--rust);
		transform: rotate(1.4deg);
	}

	.status-card p {
		margin: 0.6rem 0;
	}

	.status-label,
	.status-card span {
		font-family: ui-monospace, 'Cascadia Code', monospace;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.status-card strong {
		color: var(--ice);
		font-family: var(--font-display);
		font-size: 1.55rem;
	}

	.status-card span {
		color: rgba(246, 234, 212, 0.62);
	}

	.shelves {
		margin-top: clamp(4rem, 8vw, 7rem);
	}

	.section-title {
		margin-bottom: 1.5rem;
	}

	.shelf-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.shelf-card {
		position: relative;
		display: flex;
		min-height: 19rem;
		padding: 1.3rem;
		flex-direction: column;
		border: 2px solid var(--ink);
		color: var(--ink);
		background: var(--paper-soft);
		box-shadow: 4px 4px 0 var(--ink);
		text-decoration: none;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.shelf-card:hover {
		color: var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
		transform: translate(-3px, -3px) rotate(-0.4deg);
	}

	.shelf-card:nth-child(2) {
		background: #d8e7e4;
		transform: rotate(0.5deg);
	}

	.shelf-card:nth-child(3) {
		color: #ece8f0;
		background:
			radial-gradient(circle at 76% 22%, rgba(177, 100, 255, 0.28), transparent 11rem),
			repeating-linear-gradient(-35deg, transparent 0 21px, rgba(182, 215, 22, 0.05) 21px 22px),
			#111315;
		box-shadow: 4px 4px 0 #74419f;
		transform: rotate(-0.35deg);
	}

	.shelf-card:nth-child(3):hover {
		color: #fff;
		box-shadow: 8px 8px 0 #74419f;
	}

	.shelf-card:nth-child(3) b {
		color: #b6d716;
	}

	.shelf-card:nth-child(4) {
		background: #e7c8b7;
		transform: rotate(-0.5deg);
	}

	.card-number {
		font-family: ui-monospace, 'Cascadia Code', monospace;
		font-size: 0.72rem;
	}

	.shelf-card h3 {
		margin-top: auto;
		font-size: 2rem;
	}

	.shelf-card p {
		margin: 0.7rem 0 1.5rem;
	}

	.shelf-card b {
		font-family: ui-monospace, 'Cascadia Code', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
	}

	.tiny-manifesto {
		margin-top: clamp(4rem, 8vw, 7rem);
		padding: clamp(1.5rem, 4vw, 3rem);
		background: #e9d3a9;
	}

	.tiny-manifesto blockquote {
		max-width: 48rem;
		margin: 0.5rem 0 1.5rem;
		font-size: clamp(1.45rem, 3.5vw, 2.4rem);
	}

	@media (max-width: 800px) {
		.intro,
		.shelf-grid {
			grid-template-columns: 1fr;
		}

		.status-card {
			transform: none;
		}

		.shelf-card {
			min-height: 14rem;
		}
	}
</style>
