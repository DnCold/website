---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../lib/nav';
import PageLayout from '../layouts/PageLayout.astro';
import storykeeperChibi from '../assets/noren-icons/storykeeper.png';
import '../styles/home-writing.css';

const haikuEntry = await getEntry('writing', 'two-haikus');
const homeHaikus = haikuEntry?.body
  .trim()
  .split(/\r?\n\s*\.\s*\r?\n/)
  .map((haiku) => haiku.replace(/\\r?$/gm, '').replace(/[ \\t]+$/gm, '').trim())
  .filter(Boolean) ?? [];
const initialHaiku = homeHaikus[0] ?? '';
const haikuEntryHref = haikuEntry ? withBase('writing/' + haikuEntry.id + '/') : withBase('writing/');
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
