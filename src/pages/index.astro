---
import { Image } from 'astro:assets';
import chroniclerPortrait from '../assets/chronicler/chronicler-neutral.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../lib/nav';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<div class="retro-shell">
		<header class="browser-titlebar">
			<p><span aria-hidden="true">&#10052;</span> DanCold's Home Page!!!</p>
			<div class="fake-controls" aria-hidden="true"><i></i><i></i><i></i></div>
		</header>

		<div class="ticker" aria-label="Site announcement">
			<p>
				<span>*** WELCOME, INTERNET TRAVELER! *** THIS PAGE IS BEST VIEWED WITH CURIOSITY *** NEW ROOMS ARE ALWAYS BEING BUILT ***</span>
			</p>
		</div>

		<section class="welcome-grid" aria-labelledby="welcome-title">
			<aside class="webmaster-card">
				<p class="box-title">:: WEBMASTER ::</p>
				<div class="avatar-box" aria-hidden="true">
					<span>DC</span>
					<i>ONLINE</i>
				</div>
				<strong>DanCold</strong>
				<p>Artist / animator / 3D tinkerer / occasional code wrangler.</p>
				<dl>
					<div><dt>Mood:</dt><dd>making stuff</dd></div>
					<div><dt>Weather:</dt><dd>cold-ish</dd></div>
					<div><dt>Timezone:</dt><dd>UTC-3</dd></div>
				</dl>
				<a class="tiny-link" href={withBase('about/')}>[ about the webmaster ]</a>
			</aside>

			<div class="welcome-copy">
				<span class="new-burst">NEW!</span>
				<p class="sparkles" aria-hidden="true">+ . * . + . * . +</p>
				<h1 id="welcome-title">Welcome to my<br /><em>little corner</em> of the web</h1>
				<p class="intro-note">
					Hi! This is my personal homepage: a place for notes, drawings, animation, strange 3D
					objects, and projects that deserve somewhere nicer than an endless feed.
				</p>
				<p class="hand-note">Take your time. Click whatever looks interesting. Mind the wet paint.</p>
				<div class="mini-divider" aria-hidden="true">~*~*~*~*~*~</div>
				<p class="site-purpose">
					This site is permanently under construction and intentionally a little uneven.
				</p>
			</div>

			<aside class="updates-box">
				<p class="box-title">LATEST_UPDATES.TXT</p>
				<ul>
					<li><time datetime="2026-08-13">08.13.26</time><span>The Archivist opened her reading room.</span></li>
					<li><time datetime="2026-08-12">08.12.26</time><span>Coldem launcher terminal went online.</span></li>
					<li><time datetime="2026-08-11">08.11.26</time><span>Moved into this digital attic.</span></li>
				</ul>
				<div class="hit-counter">
					<span>You are visitor</span>
					<output aria-label="Visitor number 42">000042</output>
					<small>(approximately)</small>
				</div>
			</aside>
		</section>

		<section class="door-directory" aria-labelledby="explore">
			<header>
				<p aria-hidden="true">&starf; &starf; &starf;</p>
				<h2 id="explore">Choose a doorway</h2>
				<p aria-hidden="true">&starf; &starf; &starf;</p>
			</header>

			<div class="door-grid">
				<a class="door-card notes" href={withBase('blog/')}>
					<span class="door-icon character-icon" aria-hidden="true">
						<Image src={chroniclerPortrait} alt="" width={160} />
						<i>[TXT]</i>
					</span>
					<span><strong>THE CHRONICLER</strong><small>Field reports, devlogs & lessons rescued beyond the map.</small></span>
					<b>ENTER &gt;&gt;</b>
				</a>
				<a class="door-card archivist" href={withBase('archivist/')}>
					<span class="door-icon" aria-hidden="true">[ART]</span>
					<span><strong>THE ARCHIVIST</strong><small>Drawings, motion and curious objects by lamplight.</small></span>
					<b>ENTER &gt;&gt;</b>
				</a>
				<a class="door-card coldem" href={withBase('coldem/')}>
					<span class="door-icon" aria-hidden="true">[EXE]</span>
					<span><strong>COLDEM</strong><small>Download the launcher for DanCold games.</small></span>
					<b>ENTER &gt;&gt;</b>
				</a>
				<a class="door-card links" href={withBase('links/')}>
					<span class="door-icon" aria-hidden="true">[WWW]</span>
					<span><strong>LINKS</strong><small>Profiles, RSS and paths to the wider web.</small></span>
					<b>ENTER &gt;&gt;</b>
				</a>
			</div>
		</section>

		<section class="misc-grid" aria-label="Homepage extras">
			<article class="desktop-note">
				<p class="box-title">DESKTOP NOTE</p>
				<blockquote>“A web page can feel like a room: imperfect, specific, and unmistakably yours.”</blockquote>
				<a href={withBase('about/')}>Why I made this place &gt;&gt;</a>
			</article>

			<article class="now-playing">
				<p class="box-title">NOW PLAYING...</p>
				<div class="equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
				<strong>the sound of projects compiling</strong>
				<small>02:14 / forever</small>
				<div class="player-buttons" aria-hidden="true"><span>|&lt;</span><span>&gt;</span><span>||</span><span>&gt;|</span></div>
			</article>

			<article class="guestbook-box">
				<p class="box-title">GUESTBOOK & WEB RING</p>
				<p>The guestbook is still in the mail. Until then, leave footprints through GitHub.</p>
				<a href="https://github.com/DnCold" target="_blank" rel="noreferrer">[ visit my GitHub ]</a>
				<p class="ring-nav"><span>&lt;&lt; PREV</span><b>INDIE WEB</b><span>NEXT &gt;&gt;</span></p>
			</article>
		</section>

		<div class="button-rack" aria-label="Site badges">
			<span class="web-badge badge-ai"><b>AI</b> assisted<br />human directed</span>
			<span class="web-badge badge-rss"><b>RSS</b><br />friendly</span>
			<span class="web-badge badge-web"><b>WWW</b><br />home made</span>
			<span class="web-badge badge-feed"><b>NO</b><br />algorithm</span>
		</div>

		<p class="best-viewed">Best viewed on a screen, with images on, sometime after midnight.</p>
	</div>
</PageLayout>

<style>
	:global(.home-page-body) {
		background-color: #252546;
		background-image:
			repeating-linear-gradient(45deg, rgba(160, 184, 210, 0.08) 0 1px, transparent 1px 8px),
			radial-gradient(circle at 50% 15%, #5a496a 0, #282542 42rem, #17172d 100%);
		font-family: Verdana, Geneva, Tahoma, sans-serif;
	}

	:global(.home-page-body)::before {
		z-index: 0;
		background-image:
			radial-gradient(#d8c474 0.75px, transparent 0.75px),
			radial-gradient(#829ec5 0.65px, transparent 0.65px);
		background-position: 0 0, 11px 13px;
		background-size: 29px 29px, 37px 37px;
		opacity: 0.24;
	}

	:global(.home-page-body .site-header) {
		border-bottom-color: #111126;
		background:
			linear-gradient(180deg, rgba(252, 241, 210, 0.98), rgba(218, 192, 142, 0.96)),
			repeating-linear-gradient(90deg, transparent 0 17px, rgba(99, 71, 43, 0.08) 17px 18px);
	}

	:global(.home-page-body footer) {
		border-top-color: #d6c483;
	}

	.home-page {
		width: min(calc(100% - 1rem), 60rem);
		padding-top: 2rem;
		font-size: 0.86rem;
		line-height: 1.45;
	}

	.retro-shell {
		position: relative;
		border: 4px ridge #d9cda9;
		color: #25213b;
		background: #f0e4c7;
		box-shadow: 0 0 0 2px #101028, 14px 16px 0 rgba(9, 8, 25, 0.42);
		animation: homepage-boot 620ms steps(6, end) both;
	}

	.browser-titlebar {
		display: flex;
		min-height: 2.1rem;
		align-items: center;
		justify-content: space-between;
		padding: 0.25rem 0.4rem 0.25rem 0.65rem;
		border-bottom: 2px groove #d9cda9;
		color: #fff;
		background: linear-gradient(90deg, #15155a, #593c7a 62%, #245b6d);
		font-family: 'Trebuchet MS', Verdana, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-shadow: 1px 1px #000;
	}

	.browser-titlebar p {
		margin: 0;
	}

	.browser-titlebar p span {
		margin-right: 0.35rem;
		color: #b7efff;
	}

	.fake-controls {
		display: flex;
		gap: 3px;
	}

	.fake-controls i {
		display: block;
		width: 1.15rem;
		height: 1rem;
		border: 2px outset #ded7c1;
		background: #c8c1ac;
	}

	.fake-controls i:last-child::after {
		display: grid;
		place-items: center;
		color: #311d32;
		content: 'x';
		font: 700 0.65rem/0.65rem Arial, sans-serif;
	}

	.ticker {
		overflow: hidden;
		border-block: 2px inset #d0c5a8;
		color: #ffff8b;
		background: #28204b;
		font-family: 'Courier New', monospace;
		font-size: 0.71rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.ticker p {
		width: max-content;
		min-width: 100%;
		margin: 0;
		padding: 0.38rem 0;
		white-space: nowrap;
		animation: ticker-scroll 24s linear infinite;
	}

	.welcome-grid {
		display: grid;
		grid-template-columns: minmax(10rem, 0.68fr) minmax(19rem, 1.5fr) minmax(11.5rem, 0.82fr);
		gap: 0.65rem;
		padding: 0.75rem;
		background:
			radial-gradient(circle at center, rgba(255, 255, 255, 0.82), transparent 30rem),
			repeating-linear-gradient(0deg, transparent 0 27px, rgba(83, 66, 116, 0.055) 27px 28px),
			#efe3c5;
	}

	.webmaster-card,
	.updates-box,
	.misc-grid article {
		border: 2px groove #c2b28b;
		background: rgba(255, 251, 225, 0.86);
	}

	.webmaster-card,
	.updates-box {
		padding: 0.55rem;
	}

	.box-title {
		margin: -0.2rem -0.2rem 0.55rem;
		padding: 0.18rem 0.35rem;
		color: #fff;
		background: #53406c;
		font-family: 'Courier New', monospace;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-align: center;
	}

	.avatar-box {
		position: relative;
		display: grid;
		place-items: center;
		width: 6rem;
		margin: 0.75rem auto 0.55rem;
		aspect-ratio: 1;
		border: 4px ridge #b6a573;
		background:
			linear-gradient(135deg, transparent 48%, rgba(255, 255, 255, 0.15) 49% 51%, transparent 52%),
			repeating-conic-gradient(#323365 0 25%, #22213e 0 50%) 0 / 12px 12px;
		box-shadow: inset 0 0 1.4rem #101022;
	}

	.avatar-box span {
		color: #c8f3ff;
		font-family: Georgia, serif;
		font-size: 2.3rem;
		font-style: italic;
		font-weight: 700;
		text-shadow: 2px 2px #7d467d;
	}

	.avatar-box i {
		position: absolute;
		right: -0.35rem;
		bottom: -0.35rem;
		padding: 0.1rem 0.25rem;
		border: 1px solid #1a3821;
		color: #0f3016;
		background: #8dde73;
		font: 700 0.48rem Verdana, sans-serif;
	}

	.webmaster-card > strong {
		display: block;
		color: #514175;
		font-family: Georgia, serif;
		font-size: 1.15rem;
		text-align: center;
	}

	.webmaster-card > p:not(.box-title) {
		margin: 0.35rem 0 0.65rem;
		font-size: 0.68rem;
		text-align: center;
	}

	.webmaster-card dl {
		margin: 0.75rem 0;
		padding-top: 0.45rem;
		border-top: 1px dotted #766a59;
		font-size: 0.61rem;
	}

	.webmaster-card dl div {
		display: flex;
		justify-content: space-between;
		gap: 0.4rem;
	}

	.webmaster-card dt {
		font-weight: 700;
	}

	.webmaster-card dd {
		margin: 0;
		text-align: right;
	}

	.tiny-link {
		display: block;
		font-family: 'Courier New', monospace;
		font-size: 0.62rem;
		font-weight: 700;
		text-align: center;
	}

	.welcome-copy {
		position: relative;
		align-self: center;
		padding: 1rem clamp(0.6rem, 2vw, 1.6rem);
		text-align: center;
	}

	.new-burst {
		position: absolute;
		top: 0.15rem;
		right: 0;
		padding: 0.35rem 0.3rem;
		border: 2px dashed #7c1739;
		border-radius: 50%;
		color: #fff;
		background: #d62e5e;
		font: 900 0.58rem Verdana, sans-serif;
		transform: rotate(12deg);
		animation: burst-blink 1.15s steps(2, end) infinite;
	}

	.sparkles {
		margin: 0 0 0.35rem;
		color: #73568f;
		font-family: 'Courier New', monospace;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.welcome-copy h1 {
		color: #32284e;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2rem, 5vw, 3.65rem);
		line-height: 0.96;
		letter-spacing: -0.045em;
		text-shadow: 2px 2px 0 #d9bc75, 4px 4px 0 rgba(91, 66, 113, 0.2);
	}

	.welcome-copy h1 em {
		color: #8a3654;
		font-weight: 400;
	}

	.intro-note {
		max-width: 30rem;
		margin: 1.15rem auto 0.8rem;
		font-family: Georgia, serif;
		font-size: 0.9rem;
	}

	.hand-note {
		display: inline-block;
		margin: 0.5rem 0;
		padding: 0.35rem 0.7rem;
		color: #553820;
		background: #fff1a9;
		box-shadow: 2px 3px 0 rgba(74, 52, 34, 0.18);
		font-family: 'Comic Sans MS', 'Bradley Hand', cursive;
		font-size: 0.75rem;
		transform: rotate(-1deg);
	}

	.mini-divider {
		margin: 0.8rem 0 0.35rem;
		color: #725284;
		font-family: 'Courier New', monospace;
	}

	.site-purpose {
		margin: 0;
		font-size: 0.67rem;
	}

	.updates-box ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.updates-box li {
		padding: 0.4rem 0.2rem;
		border-bottom: 1px dotted #86775d;
		font-size: 0.63rem;
	}

	.updates-box time,
	.updates-box li span {
		display: block;
	}

	.updates-box time {
		color: #85405f;
		font-family: 'Courier New', monospace;
		font-weight: 700;
	}

	.hit-counter {
		margin-top: 0.9rem;
		padding: 0.55rem 0.25rem;
		border: 1px dashed #6e6252;
		text-align: center;
	}

	.hit-counter span,
	.hit-counter small {
		display: block;
		font-size: 0.57rem;
	}

	.hit-counter output {
		display: inline-block;
		margin: 0.25rem 0;
		padding: 0.14rem 0.3rem;
		border: 2px inset #d1d1d1;
		color: #77ff6c;
		background: #070707;
		font: 700 0.88rem 'Courier New', monospace;
		letter-spacing: 0.16em;
		text-shadow: 0 0 4px #47d745;
	}

	.door-directory {
		padding: 0 0.75rem 1rem;
		border-top: 3px double #81704d;
		background: #ddd2b7;
	}

	.door-directory > header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		padding: 0.75rem 0;
		text-align: center;
	}

	.door-directory > header h2 {
		color: #493564;
		font-family: 'Trebuchet MS', Verdana, sans-serif;
		font-size: 1.25rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-shadow: 1px 1px #fff;
	}

	.door-directory > header p {
		margin: 0;
		color: #936f27;
	}

	.door-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
	}

	.door-card {
		display: grid;
		grid-template-columns: 3.4rem minmax(0, 1fr) auto;
		gap: 0.7rem;
		align-items: center;
		min-height: 6.8rem;
		padding: 0.65rem;
		border: 3px outset #e7dcc0;
		color: #1f1a35;
		background: #f6eccf;
		text-decoration: none;
		transition: filter 120ms linear, transform 120ms steps(2, end);
	}

	.door-card:hover {
		color: #1f1a35;
		filter: brightness(1.06) saturate(1.12);
		transform: translate(-2px, -2px);
	}

	.door-card:active {
		border-style: inset;
		transform: translate(1px, 1px);
	}

	.door-card.archivist {
		background: #e8d1b0;
	}

	.door-card.coldem {
		color: #e9eef0;
		background: #181622;
	}

	.door-card.coldem:hover {
		color: #fff;
	}

	.door-card.links {
		background: #d4e3dd;
	}

	.door-icon {
		display: grid;
		place-items: center;
		width: 3.2rem;
		aspect-ratio: 1;
		border: 2px inset #c7b891;
		color: #fff;
		background: #504069;
		font: 700 0.64rem 'Courier New', monospace;
	}

	.character-icon {
		position: relative;
		overflow: hidden;
		border-color: #7f624e;
		background: #171514;
	}

	.character-icon img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 48% 30%;
		filter: contrast(1.08) sepia(0.14);
	}

	.character-icon i {
		position: absolute;
		right: 1px;
		bottom: 1px;
		padding: 0.08rem 0.16rem;
		color: #ffeab1;
		background: #1b1514;
		font: 700 0.42rem 'Courier New', monospace;
		font-style: normal;
	}

	.archivist .door-icon {
		background: #795947;
	}

	.coldem .door-icon {
		border-color: #8a73a0;
		color: #c8ed36;
		background: #542874;
	}

	.links .door-icon {
		background: #326674;
	}

	.door-card strong,
	.door-card small {
		display: block;
	}

	.door-card strong {
		font-family: 'Trebuchet MS', Verdana, sans-serif;
		font-size: 0.9rem;
		text-decoration: underline;
	}

	.door-card small {
		margin-top: 0.25rem;
		font-size: 0.61rem;
		line-height: 1.35;
	}

	.door-card b {
		font: 700 0.56rem 'Courier New', monospace;
		white-space: nowrap;
	}

	.misc-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.8fr 1fr;
		gap: 0.6rem;
		padding: 0.75rem;
		border-top: 3px double #81704d;
		background: #ede0c1;
	}

	.misc-grid article {
		min-height: 11rem;
		padding: 0.55rem;
		font-size: 0.68rem;
	}

	.desktop-note blockquote {
		margin: 0.8rem 0;
		padding: 0.4rem 0.4rem 0.4rem 0.8rem;
		border-left-width: 3px;
		font-family: 'Comic Sans MS', 'Bradley Hand', cursive;
		font-size: 0.82rem;
		line-height: 1.45;
	}

	.misc-grid a {
		font-family: 'Courier New', monospace;
		font-weight: 700;
	}

	.now-playing {
		text-align: center;
	}

	.now-playing strong,
	.now-playing small {
		display: block;
	}

	.now-playing strong {
		margin-top: 0.45rem;
		font-size: 0.66rem;
	}

	.now-playing small {
		color: #6e5a75;
		font-family: 'Courier New', monospace;
	}

	.equalizer {
		display: flex;
		height: 2.8rem;
		align-items: end;
		justify-content: center;
		gap: 3px;
		padding: 0.35rem;
		border: 2px inset #cfc3a5;
		background: #17152a;
	}

	.equalizer i {
		width: 0.35rem;
		height: 45%;
		background: #8de66d;
		box-shadow: 0 0 3px #8de66d;
		animation: equalize 720ms steps(3, end) infinite alternate;
	}

	.equalizer i:nth-child(2),
	.equalizer i:nth-child(5) {
		height: 80%;
		animation-delay: -300ms;
	}

	.equalizer i:nth-child(3) {
		height: 58%;
		animation-delay: -500ms;
	}

	.equalizer i:nth-child(4),
	.equalizer i:nth-child(6) {
		height: 28%;
		animation-delay: -180ms;
	}

	.player-buttons {
		display: flex;
		justify-content: center;
		gap: 0.18rem;
		margin-top: 0.55rem;
	}

	.player-buttons span {
		padding: 0.15rem 0.32rem;
		border: 2px outset #d9d0b8;
		background: #c9c0aa;
		font: 700 0.55rem Arial, sans-serif;
	}

	.guestbook-box p:not(.box-title) {
		margin: 0.6rem 0;
	}

	.ring-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem;
		padding-top: 0.45rem;
		border-top: 1px dotted #746752;
		font-family: 'Courier New', monospace;
