						<p>Stories, poems, haikus, and fragments kept somewhere warmer than a feed.</p>
						<span class="online-stamp">ONLINE // ACCEPTING PAGES</span>
					</div>
				</div>
				<p class="storykeeper-note">She keeps the words that arrive after midnight.</p>
				<a class="panel-link" href={withBase('writing/')}>[ visit her cabinet &gt;&gt; ]</a>
			</section>

			<section class="home-writing-panel phrase-panel" aria-label="DanCold haikus">
				<p class="box-title">HAIKUS.TXT</p>
				<header class="panel-heading">
					<h2>Haikus</h2>
					<span>{String(homeHaikus.length).padStart(2, '0')} PIECES</span>
				</header>
				<div class="home-haiku-pick" data-haiku-picker data-haikus={JSON.stringify(homeHaikus)}>
					<span>RANDOM PAGE // FROM THE STORYKEEPER</span>
					<blockquote lang="es" data-haiku-output aria-live="polite">{initialHaiku}</blockquote>
					{homeHaikus.length > 1 && <button type="button" data-haiku-shuffle>pick another ↻</button>}
				</div>
				<a class="panel-link" href={haikuEntryHref}>[ read both haikus &gt;&gt; ]</a>
			</section>
		</aside>
	</div>
</PageLayout>

<script>
	function fillRandomHaikus() {
		document.querySelectorAll<HTMLElement>('[data-haiku-picker]').forEach((picker) => {
		if (picker.dataset.haikuReady === 'true') return;
		picker.dataset.haikuReady = 'true';
			const output = picker.querySelector<HTMLElement>('[data-haiku-output]');
			const button = picker.querySelector<HTMLButtonElement>('[data-haiku-shuffle]');
			if (!output) return;

			let haikus: string[] = [];
			try {
				haikus = JSON.parse(picker.dataset.haikus ?? '[]');
			} catch {
				return;
			}

			if (haikus.length === 0) return;
			const choose = () => {
				const alternatives = haikus.filter((haiku) => haiku !== output.innerText.trim());
				const pool = alternatives.length > 0 ? alternatives : haikus;
				output.innerText = pool[Math.floor(Math.random() * pool.length)];
			};

			choose();
			button?.addEventListener('click', choose);
		});
	}

	document.addEventListener('astro:page-load', fillRandomHaikus);
	fillRandomHaikus();
</script>

