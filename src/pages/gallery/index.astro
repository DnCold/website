---
import { Image } from 'astro:assets';
import archiveGuide from '../../assets/gallery/archive-guide-manga.webp';
import { SITE_TITLE } from '../../consts';
import { GALLERY_CHAPTERS } from '../../data/gallery';
import WorldLayout from '../../layouts/WorldLayout.astro';
import { withBase } from '../../lib/nav';
import '../../styles/gallery.css';

const firstChapter = GALLERY_CHAPTERS[0];
---

<WorldLayout
	title={`The Archivist — ${SITE_TITLE}`}
	description="Choose a chapter from DanCold's visual archive: drawings, animation, and 3D experiments."
	image={archiveGuide}
	bodyClass="archive-world"
>
	<div class="archive-shell">
		<nav class="archive-nav" aria-label="Archive navigation">
			<a href={withBase()} aria-label="Leave the archive and return to the DanCold hub">← leave archive</a>
			<span>restricted collection // guest access</span>
		</nav>

		<header class="gallery-heading">
			<p class="eyebrow">Visual archive / three files found</p>
			<h1>Choose your next chapter.</h1>
			<p>
				The catalog is still taking shape. Pick a door to see what belongs there and what the
				Archivist is preparing next.
			</p>
		</header>

		<section
		class="chapter-select panel"
		data-chapter-select
		data-active={firstChapter.id}
		style={`--active-accent: ${firstChapter.accent}`}
		aria-label="Interactive gallery chapter selector"
	>
		<Image
			class="archive-art"
			src={archiveGuide}
			alt="A dark-haired archive guide seated behind a desk in a moonlit library."
			widths={[720, 1080, 1586]}
			sizes="(max-width: 760px) 100vw, 1088px"
			loading="eager"
		/>
		<div class="scene-shade" aria-hidden="true"></div>

		<div class="terminal-bar" aria-hidden="true">
			<span>DANCOLD ARCHIVE // CHAPTER SELECT</span>
			<span class="terminal-status"><i></i> ONLINE</span>
		</div>

		<div class="chapter-menu">
			<p class="menu-kicker">Select a file</p>
			<div class="chapter-tabs" role="tablist" aria-label="Gallery chapters">
				{
					GALLERY_CHAPTERS.map((chapter, index) => (
						<button
							class="chapter-tab"
							type="button"
							role="tab"
							id={`chapter-tab-${chapter.id}`}
							aria-controls={`chapter-panel-${chapter.id}`}
							aria-selected={index === 0 ? 'true' : 'false'}
							tabindex={index === 0 ? 0 : -1}
							data-chapter={chapter.id}
							data-accent={chapter.accent}
							style={`--chapter-accent: ${chapter.accent}`}
						>
							<span class="chapter-number">CH. {chapter.number}</span>
							<span class="chapter-title">{chapter.title}</span>
							<span class="chapter-summary">{chapter.summary}</span>
							<span class="selection-mark" aria-hidden="true">◆</span>
						</button>
					))
				}
			</div>
			<p class="key-hint"><kbd>↑</kbd><kbd>↓</kbd> choose <kbd>enter</kbd> open file</p>
		</div>

		<div class="guide-card">
			<span>YOUR GUIDE</span>
			<strong>The Archivist</strong>
			<p>“Choose carefully. Every unfinished thing still has a door.”</p>
		</div>
		</section>

		<section class="chapter-readout panel" aria-label="Selected chapter details">
		<p class="sr-only" aria-live="polite" data-chapter-announcer></p>
		{
			GALLERY_CHAPTERS.map((chapter, index) => (
				<article
					class="chapter-panel"
					id={`chapter-panel-${chapter.id}`}
					role="tabpanel"
					aria-labelledby={`chapter-tab-${chapter.id}`}
					data-chapter-panel={chapter.id}
					hidden={index !== 0}
					style={`--chapter-accent: ${chapter.accent}`}
				>
					<div class="chapter-file">
						<span>FILE {chapter.number}</span>
						<strong>{chapter.label}</strong>
					</div>
					<div class="chapter-copy">
						<p class="eyebrow">Current selection</p>
						<h2>{chapter.title}</h2>
						<p>{chapter.description}</p>
						<ul aria-label={`${chapter.title} topics`}>
							{chapter.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
					<p class="chapter-status"><span></span>{chapter.status}</p>
				</article>
			))
		}
		</section>

		<footer class="archive-footnote">
			<p>
				The rooms are intentionally small for now. New work will appear inside these chapters instead
				of turning the archive into an endless feed.
			</p>
			<a href={withBase()}>Return to the DanCold hub ↗</a>
		</footer>
	</div>
</WorldLayout>

<script>
	const selector = document.querySelector<HTMLElement>('[data-chapter-select]');

	if (selector) {
		const tabs = Array.from(selector.querySelectorAll<HTMLButtonElement>('[data-chapter]'));
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter-panel]'));
		const announcer = document.querySelector<HTMLElement>('[data-chapter-announcer]');

		const selectChapter = (tab: HTMLButtonElement, announce = true) => {
			const chapterId = tab.dataset.chapter;
			if (!chapterId) return;

			selector.dataset.active = chapterId;
			selector.style.setProperty('--active-accent', tab.dataset.accent ?? '#9edee8');

			for (const candidate of tabs) {
				const selected = candidate === tab;
				candidate.setAttribute('aria-selected', String(selected));
				candidate.tabIndex = selected ? 0 : -1;
			}

			for (const panel of panels) {
				panel.hidden = panel.dataset.chapterPanel !== chapterId;
			}

			if (announce && announcer) {
				announcer.textContent = `${tab.querySelector('.chapter-title')?.textContent ?? 'Chapter'} selected.`;
			}

			history.replaceState(null, '', `#${chapterId}`);
		};

		for (const tab of tabs) {
			tab.addEventListener('click', () => selectChapter(tab));
			tab.addEventListener('keydown', (event) => {
				const currentIndex = tabs.indexOf(tab);
				let nextIndex: number | undefined;

				if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
					nextIndex = (currentIndex + 1) % tabs.length;
				} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
					nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
				} else if (event.key === 'Home') {
					nextIndex = 0;
				} else if (event.key === 'End') {
					nextIndex = tabs.length - 1;
				}

				if (nextIndex !== undefined) {
					event.preventDefault();
					tabs[nextIndex].focus();
					selectChapter(tabs[nextIndex]);
				}
			});
		}

		const requestedChapter = window.location.hash.slice(1);
		const requestedTab = tabs.find((tab) => tab.dataset.chapter === requestedChapter);
		if (requestedTab) selectChapter(requestedTab, false);

		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			selector.addEventListener('pointermove', (event) => {
				const bounds = selector.getBoundingClientRect();
				const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 10;
				const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 8;
				selector.style.setProperty('--scene-x', `${x}px`);
				selector.style.setProperty('--scene-y', `${y}px`);
			});

			selector.addEventListener('pointerleave', () => {
				selector.style.setProperty('--scene-x', '0px');
				selector.style.setProperty('--scene-y', '0px');
			});
		}
	}
</script>
