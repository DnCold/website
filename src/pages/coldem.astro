---
import { Image } from 'astro:assets';
import petStickers from '../assets/coldem/pet-stickers-v6.webp';
import robotRockCover from '../assets/coldem/robot-rock-reborn-cover.png';
import runnerActive from '../assets/coldem/runner-active.png';
import runnerFull from '../assets/coldem/runner-full.png';
import runnerHead from '../assets/coldem/runner-head.png';
import runnerWelcome from '../assets/coldem/runner-welcome.png';
import { SITE_TITLE } from '../consts';
import WorldLayout from '../layouts/WorldLayout.astro';
import { withBase } from '../lib/nav';
import { getColdemReleaseData } from '../lib/coldem-release';
import '../styles/coldem.css';

const stickerStyle = `--sticker-sheet: url(${petStickers.src})`;
const launcherRepo = 'https://github.com/DnCold/Coldem-launcher';
const releaseData = await getColdemReleaseData();
const { launcher, game } = releaseData;
---

<WorldLayout
	title={`Coldem Games & The Runner — ${SITE_TITLE}`}
	description="Enter The Runner's game network, discover DanCold games, and download the optional Coldem launcher for Windows."
	image={runnerFull}
	bodyClass="coldem-world"
>
	<div class="coldem-shell" style={stickerStyle}>
		<header class="coldem-windowbar">
			<a class="coldem-wordmark" href={withBase()} aria-label="Return to the DanCold hub">
				<Image src={runnerHead} alt="" width={42} height={42} />
				<span><strong>COLDEM</strong><small>THE RUNNER'S GAME NETWORK</small></span>
			</a>
			<div class="window-status"><i></i> GAME SIGNAL ONLINE</div>
			<a class="hub-exit" href={withBase()}>EXIT TO DANCOLD ↗</a>
		</header>

		<section class="coldem-landing" aria-labelledby="coldem-title">
			<div class="coldem-landing__copy">
				<p class="system-kicker"><span></span> TRANSMISSION 001 // THE RUNNER</p>
				<h1 id="coldem-title">COLD WORLDS.<br /><em>LOUD GAMES.</em></h1>
				<p>
					Coldem is where DanCold games live: public builds, odd prototypes, and small worlds
					carried home by The Runner. The launcher helps, but the games come first.
				</p>
				<div class="hero-actions">
					<a class="coldem-button primary" href="#games">ENTER THE GAMES ↓</a>
					<a class="coldem-button" href="#runner">MEET THE RUNNER ↘</a>
				</div>
				<ul class="coldem-landing__signal" aria-label="Coldem network summary">
					<li><b>01</b><span>PUBLIC GAME</span></li>
					<li><b>04</b><span>RUNNER POSES</span></li>
					<li><b>24/7</b><span>COLD SIGNAL</span></li>
				</ul>
			</div>
			<figure class="coldem-landing__runner">
				<Image src={runnerActive} alt="The Runner rushing forward with a purple spray can" loading="eager" />
				<figcaption><b>THE RUNNER</b><span>Game courier // Ident 001</span></figcaption>
			</figure>
		</section>

		<nav class="coldem-directory" aria-label="Coldem sections">
			<a href="#games"><span>01</span><strong>GAMES</strong><small>Play what is here</small></a>
			<a href="#runner"><span>02</span><strong>THE RUNNER</strong><small>Meet the courier</small></a>
			<a href="#launcher"><span>03</span><strong>LAUNCHER</strong><small>Optional delivery tool</small></a>
			<a href="#system"><span>04</span><strong>SYSTEM</strong><small>How Coldem works</small></a>
		</nav>

		<section class="game-broadcast" id="games" aria-labelledby="games-title">
			<header class="broadcast-header">
				<div><p>NOW RECEIVING // PUBLIC CATALOG</p><h2 id="games-title">Games on the machine</h2></div>
				<span><i></i> 01 GAME ONLINE</span>
			</header>

			<article class="featured-game">
				<figure class="game-cover">
					<Image src={robotRockCover} alt="Robot Rock cover art showing colorful arena robots" loading="lazy" />
					<figcaption>CATALOG ART // RRR-001</figcaption>
				</figure>

				<div class="game-copy">
					<p class="system-kicker"><span></span> PUBLIC BUILD // GAME 001</p>
					<h3>Robot Rock<br /><em>Reborn</em></h3>
					<p>
						The latest public Coldem game package: a {game.version} build delivered, verified,
						installed, and kept ready by the launcher.
					</p>
					<ul class="game-meta" aria-label="Robot Rock Reborn details">
						<li><span>BUILD</span> {game.version}</li>
						<li><span>PLATFORM</span> WINDOWS</li>
						<li><span>STATUS</span> PUBLIC</li>
					</ul>
					<div class="hero-actions">
						<a class="coldem-button primary" href={game.releaseUrl} target="_blank" rel="noreferrer">VIEW GAME RELEASE ↗</a>
						<a class="coldem-button" href="#launcher">GET THE LAUNCHER ↓</a>
					</div>
				</div>
			</article>

			<div class="future-games" aria-label="Future Coldem game slots">
				<article><span>GAME 002</span><strong>NEXT TRANSMISSION</strong><p>Title withheld until the signal is strong enough.</p><b>UNANNOUNCED</b></article>
				<article><span>PROTOTYPE BAY</span><strong>STRANGE BUILDS LIVE HERE</strong><p>Small experiments can graduate into full Coldem releases.</p><b>WORK IN PROGRESS</b></article>
			</div>
		</section>

		<section class="runner-dossier" id="runner" aria-labelledby="runner-title">
			<figure class="runner-poster">
				<Image src={runnerFull} alt="Full-body transparent portrait of The Runner" loading="lazy" />
				<figcaption>PORTRAIT // IDENT 001</figcaption>
			</figure>

			<div class="runner-copy">
				<p>STREET FILE // PERSONA 03</p>
				<h2 id="runner-title"><span>Meet</span> The Runner</h2>
				<p class="runner-intro">
					Before Coldem, this face was DanCold's graffiti tag. Now the mark has legs,
					a spray can, and one job: carry unfinished games out into the world.
				</p>
				<blockquote>“If it runs, I can find it. If it breaks, I run faster.”</blockquote>
				<dl class="runner-facts">
					<div><dt>Known as</dt><dd>The Runner</dd></div>
					<div><dt>Origin</dt><dd>A purple tag after midnight</dd></div>
					<div><dt>Occupation</dt><dd>Game courier / system gremlin</dd></div>
					<div><dt>Attitude</dt><dd>Restless. Loyal. Slightly illegal-looking.</dd></div>
				</dl>
			</div>
			<Image class="runner-origin-mark" src={runnerHead} alt="" width={260} loading="lazy" />
		</section>

		<section class="launcher-dock" id="launcher" aria-labelledby="launcher-title">
			<header class="launcher-dock__header">
				<div><p>OPTIONAL TOOL // WINDOWS X64</p><h2 id="launcher-title">Bring the library home.</h2></div>
				<span>CLIENT V{launcher.version}</span>
			</header>

			<div class="launcher-dock__grid">
				<figure class="launcher-dock__runner">
					<Image src={runnerWelcome} alt="The Runner waving and carrying a purple spray can" loading="lazy" />
					<figcaption>YOUR COURIER IS READY</figcaption>
				</figure>

				<div class="launcher-dock__copy">
					<p class="system-kicker"><span></span> LAUNCHER ONLINE // V{launcher.version}</p>
					<h3>One cold machine.<br />Every DanCold game.</h3>
					<p>
						Install, patch, and launch the catalog from one place. There is no storefront
						account and no launcher wall between you and the public games.
					</p>
					<div class="hero-actions">
						<a class="coldem-button primary" href={launcher.installerUrl}>DOWNLOAD FOR WINDOWS ↓</a>
						<a class="coldem-button" href={launcher.releaseUrl} target="_blank" rel="noreferrer">RELEASE NOTES ↗</a>
					</div>
					<div class="install-steps">
						<article><b>01</b><span><strong>Download</strong><small>Save the setup file.</small></span></article>
						<article><b>02</b><span><strong>Install</strong><small>Open the public catalog.</small></span></article>
						<article><b>03</b><span><strong>Play</strong><small>The Runner handles the files.</small></span></article>
					</div>
				</div>

				<aside class="launcher-package" aria-label="Launcher package details">
					<p>PACKAGE READY</p>
					<strong>COLDEM<br />V{launcher.version}</strong>
					<dl>
						<div><dt>OS</dt><dd>WINDOWS 10/11</dd></div>
						<div><dt>ARCH</dt><dd>X64</dd></div>
						<div><dt>SIZE</dt><dd>{launcher.installerSize}</dd></div>
						<div><dt>CHANNEL</dt><dd>STABLE</dd></div>
					</dl>
					<p class="checksum">SHA-256<br /><code>{launcher.installerSha}</code></p>
					<a class="source-link" href={launcherRepo} target="_blank" rel="noreferrer">View source ↗</a>
				</aside>
			</div>
		</section>

		<section class="coldem-manifest" id="system" aria-labelledby="manifest-title">
			<div class="manifest-intro">
				<p>BEHIND THE MACHINE // CLD-001</p>
				<h2 id="manifest-title">Built around the games.</h2>
				<p>
					Coldem is the shelf, the delivery route, and the place where every future
					DanCold game can live together. The launcher is only one door into that world.
				</p>
			</div>
			<div class="manifest-grid">
				<article><span>01</span><h3>One growing library</h3><p>Every public game gets its own cover, status, build, and place in the catalog.</p></article>
				<article><span>02</span><h3>Smaller updates</h3><p>Incremental patches replace only the files that changed.</p></article>
				<article><span>03</span><h3>No account wall</h3><p>The public catalog works without a GitHub, itch.io, or separate Coldem account.</p></article>
			</div>
			<div class="sticker sticker-hamster" aria-hidden="true"></div>
		</section>

		<footer class="coldem-footer">
			<span>COLDEM // THE RUNNER'S GAME NETWORK // 2026</span>
			<a href={withBase()}>Return to the personal web ↗</a>
		</footer>
	</div>
</WorldLayout>
